# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
# Entorno de ejecución (afecta headers de seguridad Helmet)
# Valores: development, production, staging
NODE_ENV=development

PORT=3001

# CORS Configuration - Comma-separated list of allowed origins
# Development (single origin):
CORS_ORIGIN=http://localhost:3000
# Production (multiple origins):
# CORS_ORIGIN=https://tuapp.com,https://www.tuapp.com,https://admin.tuapp.com

# ==============================================
# AUTHENTICATION & SECURITY (REQUIRED)
# ==============================================
# IMPORTANT: Generate a strong random secret (minimum 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MINIMUM_32_CHARS

# Access token expiration (short-lived for security)
# Used for API requests. Client must refresh before expiration.
# Default: 15m (15 minutes)
JWT_EXPIRATION=15m

# Refresh token expiration (longer-lived)
# Stored in database, can be revoked manually
# Default: 7d (7 days)
# Note: This is informational - actual expiration is hardcoded in code (7 days)
JWT_REFRESH_EXPIRATION=7d

# Encryption secret for sensitive data (access tokens, refresh tokens, etc.)
# IMPORTANT: Generate a strong random secret (minimum 32 characters)
# Example: openssl rand -base64 32
# WARNING: Never change this value in production after data is encrypted, or you won't be able to decrypt it
ENCRYPTION_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MINIMUM_32_CHARS

# ==============================================
# DATABASE (REQUIRED)
# ==============================================
# PostgreSQL connection string with SSL enabled for production
# Format: postgresql://user:password@host:port/database?schema=public&sslmode=require
DATABASE_URL=postgresql://myuserpostgres:mypassword@localhost:5432/mibase?schema=public

# ==============================================
# AWS S3 CONFIGURATION (REQUIRED)
# ==============================================
# AWS credentials for S3 bucket access (product images)
AWS_S3_ACCESS_KEY_ID=your_access_key_id
AWS_S3_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_bucket_name

# AWS SES (Optional - for email service if not using Mailtrap)
AWS_SES_ACCESS_KEY=your_ses_access_key
AWS_SES_SECRET_ACCESS_KEY=your_ses_secret_access_key

# ==============================================
# EMAIL SERVICE (REQUIRED)
# ==============================================
# Mailtrap API credentials for transactional emails
MAILTRAP_TOKEN=your_mailtrap_api_token
MAILTRAP_SENDER_EMAIL=noreply@yourdomain.com

# ==============================================
# MERCADO PAGO INTEGRATION (REQUIRED)
# ==============================================
# Mercado Pago credentials (use TEST tokens for development)
MERCADOPAGO_ACCESS_TOKEN=TEST-XXXXXXXXXXXXXXXXXXXXXXXXXX
MERCADOPAGO_PUBLIC_KEY=TEST-XXXXXXXXXXXXXXXXXXXXXXXXXX

# CRITICAL: Webhook secret for signature validation (security)
# Get this from your Mercado Pago webhook configuration
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret_from_mercadopago

# Mercado Pago OAuth credentials for seller integrations (Split Payments)
# Get these from your Mercado Pago application dashboard
MERCADOPAGO_CLIENT_ID=your_client_id_from_mercadopago_app
MERCADOPAGO_CLIENT_SECRET=your_client_secret_from_mercadopago_app
MERCADOPAGO_REDIRECT_URI=http://localhost:3000/integrations/mercadopago/callback

# ==============================================
# FRONTEND & BACKEND URLS
# ==============================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# ==============================================
# NOTES
# ==============================================
# - All variables marked as (REQUIRED) MUST be set for the application to start
# - Never commit your actual .env file to version control
# - Use strong, randomly generated secrets for JWT_SECRET
# - In production, always use SSL for database connections (sslmode=require)
# - For production, use production Mercado Pago credentials (not TEST-)
